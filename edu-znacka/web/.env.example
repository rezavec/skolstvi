# ── Databáze ────────────────────────────────────────────────────────────────
# Connection string z Neonu (Dashboard → Connection Details → pooled).
# Musí obsahovat ?sslmode=require
DATABASE_URL=

# ── Podpis cookies ──────────────────────────────────────────────────────────
# Tajný klíč pro podepisování přihlašovacích cookies. Minimálně 32 znaků.
# Vygeneruj: openssl rand -base64 48
APP_SECRET=

# ── Správce (ty) ────────────────────────────────────────────────────────────
# Heslo do /admin. Zvol dlouhé, nikde jinde nepoužité.
ADMIN_PASSWORD=

# ── Kdo se smí přihlásit jako recenzent ─────────────────────────────────────
# Akademické domény, oddělené čárkou. Platí i jejich subdomény, takže
# `cuni.cz` pustí i `mff.cuni.cz` — fakultní adresy jsou běžnější než
# ty univerzitní. `evil-cuni.cz` ani `cuni.cz.utocnik.cz` tím neprojdou.
#
# Odborník bez adresy na těchto doménách (typicky ze zahraničí) se musí
# přihlásit přes tebe — v /admin/recenzenti ho pozveš ručně.
ACADEMIC_EMAIL_DOMAINS=cuni.cz,muni.cz,cvut.cz,vutbr.cz,upol.cz,jcu.cz,zcu.cz,tul.cz,uhk.cz,ujep.cz,osu.cz,slu.cz,upce.cz,vsb.cz,vscht.cz,czu.cz,mendelu.cz,utb.cz,vfu.cz,amu.cz,avu.cz,jamu.cz,cas.cz,avcr.cz

# ── Odesílání e-mailů ───────────────────────────────────────────────────────
# console = nic se neodesílá, odkaz se vypíše do terminálu a do
#           .dev-mail/last.json (pro vývoj a testování)
# resend  = odesílá se opravdu, přes Resend API
MAIL_DRIVER=console

# API klíč z Resendu (resend.com → API Keys). Jen pro MAIL_DRIVER=resend.
RESEND_API_KEY=

# Odesílatel. Doména musí být v Resendu ověřená, jinak Resend odmítne odeslat.
MAIL_FROM=Edu značka <znacka@priklad.cz>

# Kam ti chodí upozornění na novou žádost recenzenta a na novou námitku.
# Nech prázdné, pokud je nechceš.
ADMIN_NOTIFY_EMAIL=

# ── Adresa aplikace ─────────────────────────────────────────────────────────
# Používá se pro odkazy v e-mailech a pro odkaz ze značky v rozšíření.
# BEZ lomítka na konci.
APP_URL=http://localhost:3000
