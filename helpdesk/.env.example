# ── Databáze ────────────────────────────────────────────────────────────────
# Connection string z Neonu (Dashboard → Connection Details → pooled).
# Musí obsahovat ?sslmode=require
DATABASE_URL=

# ── Podpis cookies ──────────────────────────────────────────────────────────
# Tajný klíč pro podepisování přihlašovacích cookies. Minimálně 32 znaků.
# Vygeneruj: openssl rand -base64 48
APP_SECRET=

# ── Admin (ty) ──────────────────────────────────────────────────────────────
# Heslo do /admin. Zvol dlouhé, nikde jinde nepoužité.
ADMIN_PASSWORD=

# ── Kdo smí zadávat tikety ──────────────────────────────────────────────────
# Povolené e-mailové domény, oddělené čárkou. Nikdo jiný odkaz nedostane.
ALLOWED_EMAIL_DOMAINS=zsulesa.cz

# ── Odesílání e-mailů ───────────────────────────────────────────────────────
# console = nic se neodesílá, odkaz se vypíše do terminálu a do
#           .dev-mail/last.json (pro vývoj a testování)
# resend  = odesílá se opravdu, přes Resend API
MAIL_DRIVER=console

# API klíč z Resendu (resend.com → API Keys). Jen pro MAIL_DRIVER=resend.
RESEND_API_KEY=

# Odesílatel. Doména musí být v Resendu ověřená, jinak Resend odmítne odeslat.
MAIL_FROM=Helpdesk ZŠ <helpdesk@zsulesa.cz>

# Kam ti chodí upozornění na nový tiket. Nech prázdné, pokud je nechceš.
ADMIN_NOTIFY_EMAIL=

# ── Adresa aplikace ─────────────────────────────────────────────────────────
# Používá se pro stavbu odkazů v e-mailech. BEZ lomítka na konci.
# Na Vercelu nastav na veřejnou adresu, např. https://helpdesk.vercel.app
APP_URL=http://localhost:3000
